#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

PYTHON="${MIDNIGHT_PYTHON:-$ROOT/.venv/bin/python}"
PLATFORM_CONFIG="${MIDNIGHT_PLATFORM_CONFIG:-$ROOT/config/platform.local.yaml}"
CONCURRENCY="${MIDNIGHT_COMPETITION_CONCURRENCY:-2}"
RUN_TIMEOUT="${MIDNIGHT_COMPETITION_RUN_TIMEOUT:-1620}"
TASK_TIMEOUT="${MIDNIGHT_COMPETITION_TASK_TIMEOUT:-1800}"
WAIT_FOR_CHALLENGES="${MIDNIGHT_COMPETITION_WAIT_FOR_CHALLENGES:-300}"

usage() {
  cat <<'EOF'
Usage: scripts/competition COMMAND [ARG]

Commands:
  local-preflight       Check configuration, organizer model, and local sandboxes
  platform-preflight    Read and normalize the official challenge inventory
  dry-run ID            Solve one organizer test task without submitting
  submit-test ID        Solve and submit one organizer-authorized test task
  rehearsal             Auto-fetch, re-solve, and submit all test-platform tasks
  monitor RUN_ID        Follow the redacted event stream for a running test
  round2                Start the unattended 27-minute second-stage run
  round3                Start the unattended 27-minute final-stage run

Local overrides:
  MIDNIGHT_PLATFORM_CONFIG
  MIDNIGHT_RUN_ID
  MIDNIGHT_COMPETITION_CONCURRENCY
  MIDNIGHT_COMPETITION_RUN_TIMEOUT
  MIDNIGHT_COMPETITION_TASK_TIMEOUT
  MIDNIGHT_COMPETITION_WAIT_FOR_CHALLENGES

Credentials must remain in the protected .env file. This script never prints them.
EOF
}

require_runtime() {
  if [[ ! -x "$PYTHON" ]]; then
    echo "Missing local Python environment: $PYTHON" >&2
    exit 2
  fi
}

require_platform_config() {
  if [[ ! -f "$PLATFORM_CONFIG" ]]; then
    echo "Missing ignored platform config: $PLATFORM_CONFIG" >&2
    exit 2
  fi
}

run_midnight() {
  "$PYTHON" -m midnight.app "$@"
}

run_single() {
  local stage="$1"
  local challenge_id="$2"
  local submission="$3"
  local run_id="${MIDNIGHT_RUN_ID:-$stage}"
  local output_root="$ROOT/logs/$run_id"
  mkdir -p "$output_root"
  local -a args=(
    --platform-config "$PLATFORM_CONFIG"
    --id "$challenge_id"
    --run-id "$run_id"
    --max-concurrency 1
    --task-timeout 900
    --events-path "$output_root/events.jsonl"
    --checkpoint-path "$output_root/checkpoints.sqlite"
    --submission-ledger-path "$output_root/submissions.sqlite"
    --artifacts-root "$output_root/artifacts"
    --workspace-root "$output_root/workspaces"
    --report-path "$output_root/report.json"
  )
  if [[ "$submission" == "enabled" ]]; then
    args+=(--submit)
  fi
  run_midnight "${args[@]}"
}

run_round() {
  local stage="$1"
  local run_id="${MIDNIGHT_RUN_ID:-$stage}"
  local output_root="$ROOT/logs/$run_id"
  mkdir -p "$output_root"
  local -a runner=("$PYTHON")
  if command -v caffeinate >/dev/null 2>&1; then
    runner=(caffeinate -dimsu "$PYTHON")
  fi
  exec "${runner[@]}" -m midnight.app \
    --platform-config "$PLATFORM_CONFIG" \
    --run-id "$run_id" \
    --submit \
    --max-concurrency "$CONCURRENCY" \
    --task-timeout "$TASK_TIMEOUT" \
    --run-timeout "$RUN_TIMEOUT" \
    --wait-for-challenges "$WAIT_FOR_CHALLENGES" \
    --events-path "$output_root/events.jsonl" \
    --checkpoint-path "$output_root/checkpoints.sqlite" \
    --submission-ledger-path "$output_root/submissions.sqlite" \
    --artifacts-root "$output_root/artifacts" \
    --workspace-root "$output_root/workspaces" \
    --report-path "$output_root/report.json"
}

run_rehearsal() {
  local run_id="${MIDNIGHT_RUN_ID:-rehearsal-$(date +%Y%m%d-%H%M%S)}"
  local output_root="$ROOT/logs/$run_id"
  mkdir -p "$output_root"
  local -a runner=("$PYTHON")
  if command -v caffeinate >/dev/null 2>&1; then
    runner=(caffeinate -dimsu "$PYTHON")
  fi
  exec "${runner[@]}" -m midnight.app \
    --platform-config "$PLATFORM_CONFIG" \
    --include-solved \
    --run-id "$run_id" \
    --submit \
    --max-concurrency "$CONCURRENCY" \
    --task-timeout "$TASK_TIMEOUT" \
    --run-timeout "$RUN_TIMEOUT" \
    --events-path "$output_root/events.jsonl" \
    --checkpoint-path "$output_root/checkpoints.sqlite" \
    --submission-ledger-path "$output_root/submissions.sqlite" \
    --artifacts-root "$output_root/artifacts" \
    --workspace-root "$output_root/workspaces" \
    --report-path "$output_root/report.json"
}

command="${1:-help}"
case "$command" in
  help|-h|--help)
    usage
    ;;
  local-preflight)
    require_runtime
    docker info >/dev/null
    run_midnight --check-config
    run_midnight --check-model
    run_midnight --check-sandboxes
    ;;
  platform-preflight)
    require_runtime
    require_platform_config
    run_midnight --platform-config "$PLATFORM_CONFIG" --list-only
    ;;
  dry-run)
    require_runtime
    require_platform_config
    challenge_id="${2:?dry-run requires a test challenge ID}"
    run_single platform-dry-run "$challenge_id" disabled
    ;;
  submit-test)
    require_runtime
    require_platform_config
    challenge_id="${2:?submit-test requires an organizer-authorized challenge ID}"
    run_single platform-submit-test "$challenge_id" enabled
    ;;
  rehearsal)
    require_runtime
    require_platform_config
    run_rehearsal
    ;;
  monitor)
    run_id="${2:?monitor requires a run ID}"
    event_path="$ROOT/logs/$run_id/events.jsonl"
    if [[ ! -f "$event_path" ]]; then
      echo "No event stream yet: $event_path" >&2
      exit 2
    fi
    exec tail -n +1 -f "$event_path"
    ;;
  round2|round3)
    require_runtime
    require_platform_config
    run_round "$command"
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
