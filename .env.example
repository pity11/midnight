# —— 模型供应商凭据（按需填写）——
# 云端 Anthropic（默认 models.yaml 指向）
ANTHROPIC_API_KEY=

# 可选：其他供应商
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# 本地 Ollama（无需 key，确保 ollama 服务在运行）
# OLLAMA_BASE_URL=http://localhost:11434

# —— 运行时覆盖（可选，留空则用 config/settings.yaml）——
# MIDNIGHT_MAX_CONCURRENCY=3
# MIDNIGHT_PER_TASK_TIMEOUT=1800
# MIDNIGHT_RECURSION_LIMIT=100
